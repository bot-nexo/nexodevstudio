---
import Button from "../ui/Button.astro";
import GridBackground from "../ui/GridBackground.astro";
import { COMPANY } from "../../data/company";
---

<section
    id="hero"
    class="relative flex min-h-screen items-center overflow-hidden pt-32"
>
    <GridBackground />

    <div class="container relative z-10">
        <div
            class="inline-flex items-center gap-2 text-sm font-semibold text-zinc-400 animate-pulse"
        >
            <div class="h-3 w-3 rounded-full bg-purple-500"></div>
            Disponible para Sesión de Estrategia Gratuita
        </div>

        <h1
            class="mt-8 max-w-5xl text-6xl font-bold leading-none tracking-tight md:text-8xl"
        >
            Transformamos

            <span class="text-violet-400"> ideas en ventas </span>

            con desarrollo web estratégico.
        </h1>

        <p class="mt-8 max-w-2xl text-xl leading-8 text-zinc-400">
            Creamos landing pages y aplicaciones web enfocadas en la conversión, velocidad y escalabilidad. No usamos plantillas lentas, desarrollamos a medida.
        </p>

        <div class="mt-12 flex flex-wrap gap-4">
            <Button
                href={COMPANY.whatsapp}
                target="_blank"
                rel="noopener noreferrer"
            >
                Agendar Sesión de 30 min (Gratis)
            </Button>
        </div>
    </div>
</section>
