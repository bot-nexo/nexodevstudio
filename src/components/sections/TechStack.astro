---
import Container from "../ui/Container.astro";

const stack = [
    "Astro",
    "TypeScript",
    "Tailwind CSS",
    "Node.js",
    "Supabase",
    "PostgreSQL",
    "n8n",
    "OpenAI API"
];
---

<section id="tech-stack" class="py-12 border-y border-white/10 bg-white/5" style="padding: 3rem 0; border-top: 1px solid rgba(255,255,255,0.1); border-bottom: 1px solid rgba(255,255,255,0.1); background: rgba(255,255,255,0.02);">
    <Container>
        <div class="flex flex-col items-center gap-6" style="display: flex; flex-direction: column; align-items: center; gap: 1.5rem;">
            <p class="text-sm text-gray-400 uppercase tracking-widest font-semibold" style="font-size: 0.875rem; color: #9ca3af; text-transform: uppercase; letter-spacing: 0.1em; font-weight: 600;">Nuestro Stack Oficial</p>
            <div class="flex flex-wrap justify-center gap-4 md:gap-8" style="display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem;">
                {stack.map((tech) => (
                    <div class="px-4 py-2 rounded-full border border-white/10 bg-black/50 text-gray-300 text-sm md:text-base font-medium transition-colors hover:border-white/30" style="padding: 0.5rem 1rem; border-radius: 9999px; border: 1px solid rgba(255,255,255,0.1); background: rgba(0,0,0,0.5); color: #d1d5db; font-size: 0.875rem; font-weight: 500; cursor: default;">
                        {tech}
                    </div>
                ))}
            </div>
        </div>
    </Container>
</section>
